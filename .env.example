# Server-only settings. Supply real values through the deployment's secret settings.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SCAN_HASH_SECRET=
SCAN_OPERATOR_SECRET=
# Use the same value as SCAN_OPERATOR_SECRET for the protected daily cleanup.
CRON_SECRET=
SCANS_ENABLED=false
# Optional Google API alternative to the isolated Lighthouse worker.
PAGESPEED_API_KEY=
# Optional warm, credential-free browser image for faster Lighthouse startup.
LIGHTHOUSE_SANDBOX_SNAPSHOT_ID=

# Optional private accounts; all settings remain server-side.
SUPABASE_PUBLISHABLE_KEY=
ACCOUNTS_ENABLED=false
GRADER_ADMIN_EMAILS=
AUTH_EMAIL_ENABLED=false
REPORT_EMAIL_ENABLED=false
RESEND_API_KEY=
GRADER_EMAIL_FROM=
GRADER_APP_URL=https://pearl-legal-grader.vercel.app
RESEND_WEBHOOK_SECRET=
# Optional source-grounded explanations; disabled unless both are configured.
AI_REVIEW_ENABLED=false
OPENAI_API_KEY=

# Separate explicit educational series; preview sends remain disabled.
NURTURE_EMAIL_ENABLED=false
# Separate opt-in reporting reminders and owner-requested sample; production only.
REPORTING_REMINDERS_ENABLED=false
GRADER_BUSINESS_NAME=
GRADER_POSTAL_ADDRESS=
